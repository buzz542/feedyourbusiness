# Copy to .env.local for local development. Never commit real values.
# In production set these in Vercel (Project Settings > Environment Variables).

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (project "askedfor", London, ref hoqbflkszzoojdswbrgy) ---
NEXT_PUBLIC_SUPABASE_URL=https://hoqbflkszzoojdswbrgy.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Server only. Never import in client code. Supabase dashboard > Project Settings > API Keys.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# --- Stripe (TEST mode keys only until the live checklist in docs/BILLING.md is done) ---
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me
# Merchant of record. The brief requires it (VAT and sales tax handled for us). Defaults to true.
STRIPE_MANAGED_PAYMENTS=true
# Live mode needs a live key AND this set to "true" AND Managed Payments on. See docs/BILLING.md.
BILLING_LIVE_ENABLED=false

# --- Email (Resend) ---
RESEND_API_KEY=re_replace_me
EMAIL_FROM=AskedFor <hello@example.invalid>

# --- Cron (Vercel sends this as a Bearer token on cron requests) ---
CRON_SECRET=replace_me_with_a_long_random_string

# --- Models (M2 onward) ---
ANTHROPIC_API_KEY=sk-ant-replace_me
LLM_MONTHLY_USD_CAP_PER_PRODUCT=3
LLM_DAILY_USD_CAP=25

# --- Privacy keys (M3 onward). 32+ random characters each. NEVER rotate AUTHOR_HASH_PEPPER. ---
AUTHOR_HASH_PEPPER=replace_me_with_a_long_random_string
APP_HMAC_SECRET=replace_me_with_another_long_random_string

# --- Collect-source kill switches (M3 onward). Anything but "true" means off. docs/PLAN.md section 7. ---
SOURCE_HACKERNEWS_ENABLED=false
SOURCE_BLUESKY_ENABLED=false
SOURCE_REDDIT_ENABLED=false
SOURCE_X_ENABLED=false

# Bluesky: the dedicated AskedFor account and an app password (never the account password).
BLUESKY_IDENTIFIER=askedfor.example.invalid
BLUESKY_APP_PASSWORD=replace_me

# Reddit through the contracted data vendor (route C, decision D1).
REDDIT_PROVIDER=brightdata
BRIGHTDATA_API_TOKEN=replace_me
BRIGHTDATA_REDDIT_DATASET_ID=gd_replace_me
BRIGHTDATA_COST_PER_1K=1.50
BRIGHTDATA_MONTHLY_RECORD_CAP=20000
REDDIT_DAILY_RECORDS_PER_PRODUCT=120

# X: official API only, off by default. A budget of 0 means no calls.
X_BEARER_TOKEN=replace_me
X_DAILY_READS_PER_PRODUCT=0

# --- Instant preview (M9) ---
PREVIEW_DAILY_CAP=200
