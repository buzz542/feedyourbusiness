      "catalogue",
      "labelled",
      "cancelled",
      "cancelling",
      "whilst"
    ]
  },

  "logos": {
    "_comment": "Platform names appear in text only. No logo files without written permission.",
    "publicDir": "public",
    "imageExtensions": [".svg", ".png", ".jpg", ".jpeg", ".webp", ".gif", ".ico", ".avif"],
    "forbiddenNames": [
