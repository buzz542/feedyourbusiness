{
  "_comment": "Single source of truth for the compliance gates and the PreToolUse install hook. Changing it changes a hard rule, so it needs founder approval (docs/PLAN.md, section 2). Route C keeps every package here blocked: vendors are called through their REST APIs with safeFetch().",

  "packages": {
    "blocked": [
      "puppeteer",
      "puppeteer-core",
      "puppeteer-extra",
      "puppeteer-extra-plugin-stealth",
      "puppeteer-extra-plugin-recaptcha",
      "rebrowser-puppeteer",
      "rebrowser-playwright",
      "playwright-extra",
      "playwright-stealth",
      "patchright",
      "selenium",
      "selenium-webdriver",
      "undetected-chromedriver",
      "chromedriver",
      "zombie",
      "nightmare",
      "phantomjs",
      "phantomjs-prebuilt",
      "x-ray",
      "apify",
      "apify-client",
      "crawlee",
      "brightdata",
      "bright-data",
      "serpapi",
      "google-search-results",
      "google-search-results-nodejs",
      "oxylabs",
      "scrapingbee",
      "scraperapi",
      "zenrows",
      "scrapfly-sdk",
      "firecrawl",
      "browserless",
      "scrapy",
      "scrapy-splash",
      "snscrape",
      "twint",
      "rettiwt-api",
      "agent-twitter-client",
      "instagram-private-api",
      "instagrapi",
      "tiktok-scraper",
      "linkedin-api",
      "snoowrap",
      "praw",
      "asyncpraw"
    ],
    "blockedScopes": [
      "@apify",
      "@crawlee",
      "@brightdata",
      "@oxylabs",
      "@browserless",
      "@scrapfly",
      "@zenrows",
      "@scrapingbee",
      "@mendable",
      "@the-convocation"
    ],
    "devOnly": ["playwright", "playwright-core", "@playwright/test"]
  },

  "networkModules": [
    "http",
    "https",
    "http2",
    "net",
    "tls",
    "dgram",
    "dns",
    "child_process",
    "node-fetch",
    "cross-fetch",
    "isomorphic-fetch",
    "whatwg-fetch",
    "undici",
    "axios",
    "got",
    "ky",
    "superagent",
    "needle",
    "request",
    "request-promise",
    "ofetch",
    "bent",
    "phin",
    "ws",
    "eventsource",
    "socket.io-client"
  ],

  "schema": {
    "postTables": ["posts", "product_posts"],
    "bannedColumnPattern": "avatar|bio|follower|following|email|phone|photo|picture|image|profile_url",
    "anonGrantsForbidden": true
  },

  "copy": {
    "scanRoots": ["src/app/(marketing)", "emails"],
    "appScanRoots": ["src/app/(app)", "src/app/(admin)", "src/components"],
    "bannedPhrases": [
      "revolutionary",
      "game-changing",
      "game changing",
      "game changer",
      "cutting-edge",
      "next-level",
      "supercharge",
      "seamless",
      "seamlessly",
      "effortless",
      "effortlessly",
      "unlock",
      "10x",
      "world-class",
      "best-in-class",
      "state-of-the-art",
      "skyrocket",
      "guaranteed",
      "guarantee",
      "never scrape",
      "no scraping",
      "without scraping",
      "don't scrape",
      "don\u2019t scrape",
      "do not scrape",
      "official apis only",
      "only use official apis",
      "only official apis",
      "official api only",
      "not a scraper",
      "dont scrape",
      "doesn't scrape",
      "doesn\u2019t scrape",
      "does not scrape",
      "scraping-free",
      "scrape-free"
    ],
    "competitorNames": [
      "ownfeed",
      "gummysearch",
      "gummy search",
      "f5bot",
      "syften",
      "octolens",
      "brand24",
      "redreach"
    ],
    "ukSpellings": [
